# Briefings (/b/[slug]) — variáveis da Cloudflare Pages Function.
# Produção: Cloudflare → Workers & Pages → (projeto) → Settings → Variables and Secrets.
# Local: copie para .dev.vars (já ignorado pelo git) e rode `npx wrangler pages dev .`

# Chave da API do Resend (resend.com → API Keys). Tipo "Secret".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. O domínio precisa estar verificado no Resend.
BRIEFING_FROM="Mauricio Filho <talk@mfilho.com>"

# Segredo para assinar tokens e cookies. Gere com: openssl rand -hex 32
BRIEFING_SECRET=troque-por-um-valor-aleatorio-longo

# Opcional: senha de um briefing. O nome é o que o arquivo do briefing
# indica em "password" (ex.: "password": "BRIEFING_PASS_ACME").
# BRIEFING_PASS_ACME=senha-do-cliente

# Opcional: rate limit persistente. Não é variável de texto: é um binding
# de KV namespace chamado BRIEFING_KV (Settings → Bindings → KV namespace).
# Sem ele, o limite vale só por instância (mais fraco).
