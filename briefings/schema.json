{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Briefing",
  "description": "Configuração de um briefing servido em /b/[slug]. O arquivo se chama [slug].json e fica nesta pasta.",
  "type": "object",
  "required": ["slug", "name", "title", "intro", "duration", "recipientEmail", "emailSubject", "success", "steps", "questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "description": "Igual ao nome do arquivo, sem .json. Vira a URL /b/[slug]."
    },
    "name": { "type": "string", "description": "Nome curto do briefing. Usado no assunto do e-mail via {name}." },
    "lang": { "type": "string", "default": "pt" },
    "title": { "type": "string", "description": "Título da tela inicial." },
    "intro": { "type": "string", "description": "Texto curto da tela inicial." },
    "duration": { "type": "string", "description": "Duração estimada, ex.: \"3 a 5 minutos\"." },
    "recipientEmail": {
      "type": "string",
      "format": "email",
      "description": "Quem recebe as respostas. Fica só no servidor, nunca vai para o navegador."
    },
    "emailSubject": {
      "type": "string",
      "description": "Assunto do e-mail. Aceita {name}, {title}, {slug}, {idDaPergunta} e {idDoContato.idDoCampo}."
    },
    "password": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "description": "Opcional. NOME da variável de ambiente com a senha (ex.: BRIEFING_PASS_ACME), nunca a senha."
    },
    "minSeconds": {
      "type": "integer",
      "minimum": 0,
      "default": 15,
      "description": "Anti-spam: tempo mínimo entre abrir a página e enviar."
    },
    "success": {
      "type": "object",
      "required": ["title", "text"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string" },
        "link": {
          "type": "object",
          "description": "Opcional. Botão na tela final, ex.: voltar para a home do site.",
          "required": ["label", "href"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "href": { "type": "string", "pattern": "^(/(?!/)|https://)", "description": "Link interno (\"/\") ou https." }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "Opcional. Sobrescreve textos da interface (botões, mensagens). Chaves em assets/briefing/engine.js → UI.",
      "additionalProperties": { "type": ["string", "object"] }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Etapas, na ordem. A numeração (01, 02…) é automática e só conta etapas visíveis.",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "description": "Perguntas, na ordem em que aparecem. Uma por tela.",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "step", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "Único no arquivo. Chave da resposta." },
        "step": { "type": "string", "description": "id de uma etapa em steps." },
        "type": { "enum": ["text", "textarea", "single", "multi", "contact"] },
        "label": { "type": "string", "description": "A pergunta." },
        "help": { "type": "string", "description": "Texto de apoio, abaixo da pergunta." },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "maxLength": { "type": "integer", "minimum": 1 },
        "showIf": { "$ref": "#/$defs/condition" },
        "options": {
          "type": "array",
          "description": "Para single e multi.",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" },
              "other": { "type": "boolean", "description": "Abre um campo de texto quando escolhida." },
              "exclusive": { "type": "boolean", "description": "Só em multi: desmarca as outras e vice-versa." }
            }
          }
        },
        "fields": {
          "type": "array",
          "description": "Para contact.",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "enum": ["text", "email", "tel"], "default": "text" },
              "required": { "type": "boolean", "default": false },
              "mask": { "enum": ["phone-br"] },
              "autocomplete": { "type": "string" },
              "maxLength": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "condition": {
      "description": "Mostra a pergunta só se a condição valer. Só referencia perguntas anteriores.",
      "type": "object",
      "oneOf": [
        { "required": ["q", "equals"] },
        { "required": ["q", "in"] },
        { "required": ["q", "notIn"] },
        { "required": ["q", "filled"] },
        { "required": ["all"] },
        { "required": ["any"] },
        { "required": ["not"] }
      ],
      "properties": {
        "q": { "type": "string" },
        "equals": { "type": "string" },
        "in": { "type": "array", "items": { "type": "string" } },
        "notIn": { "type": "array", "items": { "type": "string" } },
        "filled": { "type": "boolean" },
        "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
